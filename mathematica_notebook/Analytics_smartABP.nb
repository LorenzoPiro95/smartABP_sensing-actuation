Cell[CellGroupData[{

Cell["Pareto-front plots", "Subsection",ExpressionUUID->"a15b622e-1331-40c4-a6a6-f96ec295fb68"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "GENERATE", " ", "DATA", " ", "FOR", " ", "SCATTER", " ", "PLOTS"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"\[Kappa]_", ",", "\[Sigma]m_"}], "]"}], ":=", 
     RowBox[{"\[Kappa]", " ", 
      RowBox[{"c0", "[", 
       RowBox[{"1", "/", "\[Sigma]m"}], "]"}]}]}], ";"}], "  ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kappaVals", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"Log", "[", "0.01", "]"}], ",", 
        RowBox[{"Log", "[", "1", "]"}], ",", "30"}], "]"}], "]"}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmaVals", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"Log", "[", "0.01", "]"}], ",", 
        RowBox[{"Log", "[", "10", "]"}], ",", "30"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"epsA", " ", "=", " ", "1"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pointsA", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"\[Kappa]", ",", "\[Sigma]"}], "]"}], "<=", "1.5"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"varrAP", "[", 
              RowBox[{"\[Kappa]", ",", "\[Sigma]", ",", "epsA"}], "]"}], ",", 
             
             RowBox[{
              RowBox[{"\[Sigma]actpinnedAP", "[", 
               RowBox[{"\[Kappa]", ",", "\[Sigma]", ",", "epsA"}], "]"}], "+", 
              RowBox[{"\[Sigma]actnablaAP", "[", 
               RowBox[{"\[Kappa]", ",", "\[Sigma]", ",", "epsA"}], "]"}], "+", 
              RowBox[{"\[Sigma]sensAP", "[", 
               RowBox[{"\[Kappa]", ",", "\[Sigma]", ",", "epsA"}], "]"}]}], ",", 
             RowBox[{"1", "/", 
              RowBox[{"meanvel", "[", 
               RowBox[{"\[Kappa]", ",", "\[Sigma]", ",", "epsA"}], "]"}]}]}], 
            "}"}], ",", "Nothing"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Kappa]", ",", "kappaVals"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", "sigmaVals"}], "}"}]}], "]"}], ",", "1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"epsB", "=", "3"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pointsB", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"\[Kappa]", ",", "\[Sigma]"}], "]"}], "<=", "1.5"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"varrAP", "[", 
              RowBox[{"\[Kappa]", ",", "\[Sigma]", ",", "epsB"}], "]"}], ",", 
             
